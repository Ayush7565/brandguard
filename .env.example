# Copy to .env (never commit .env). All values are optional for local use.
SECRET_KEY=change-me
# Optional: enables the AI layer (Claude API). Without it the deterministic checks still run.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cost protection for the AI layer
AI_USER_HOURLY_LIMIT=15
AI_DAILY_LIMIT=300
# 1 = show one-click demo logins (recommended for judging), 0 = hide them
DEMO_MODE=1
# DATABASE_PATH=instance/brandguard.db
